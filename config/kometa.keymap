#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
};

/ {
    behaviors {
        hr: hr {
            compatible = "zmk,behavior-hold-tap";
            label = "home_row";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
        };

        copy: copy {
            compatible = "zmk,behavior-tap-dance";
            label = "COPY";
            #binding-cells = <0>;
            bindings = <&kp C>, <&kp K_COPY>;
        };

        paste: paste {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp INSERT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cha {
            bindings = <&kp LBKT>;
            key-positions = <8 7>;
        };

        znak {
            bindings = <&kp RBKT>;
            key-positions = <8 9>;
        };

        ue {
            bindings = <&kp SQT>;
            key-positions = <33 34>;
        };

        yo {
            bindings = <&kp GRAVE>;
            key-positions = <5 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none          &kp Q           &kp W       &kp E        &kp R         &kp T      &kp Y        &kp U         &kp I        &kp O       &kp P               &none
&tog 7         &hr LEFT_GUI A  &hr LALT S  &hr LCTRL D  &hr LSHIFT F  &kp G      &kp H        &hr RSHIFT J  &hr RCTRL K  &hr RALT L  &hr RIGHT_GUI SEMI  &kp SQT
&kp LG(SPACE)  &kp Z           &kp X       &kp C        &kp V         &kp B      &kp N        &kp M         &kp COMMA    &kp DOT     &kp FSLH            &kp LG(SPACE)
                                           &lt 3 ESC    &lt 1 SPACE   &lt 2 TAB  &lt 5 ENTER  &lt 4 BSPC    &lt 6 DEL
            >;
        };

        nav {
            bindings = <
&none   &none         &none     &none      &none       &none  &kp INS    &kp PAGE_DOWN  &kp UP     &kp PAGE_UP  &kp HOME   &none
&none   &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none  &kp CAPS   &kp LEFT       &kp DOWN   &kp RIGHT    &kp END    &none
&trans  &none         &none     &none      &none       &none  &kp LC(Y)  &kp LC(V)      &kp LC(C)  &kp LC(X)    &kp LC(Z)  &trans
                                &none      &trans      &none  &kp ENTER  &kp BSPC       &kp DEL
            >;
        };

        mouse {
            bindings = <
&none   &none     &none     &none      &none      &none   &none      &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &msc SCRL_LEFT   &none
&none   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none   &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
&trans  &none     &none     &none      &none      &none   &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)        &kp LC(Z)        &trans
                            &none      &none      &trans  &mkp MB1   &mkp MB3        &mkp MB2
            >;
        };

        media {
            bindings = <
&none   &none     &none     &none      &none      &none  &bt BT_CLR    &none             &none         &none         &none         &none
&none   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &none         &kp C_PREV        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none
&trans  &none     &none     &none      &none      &none  &out OUT_TOG  &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
                            &trans     &none      &none  &kp C_STOP    &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        num {
            bindings = <
&none   &kp FSLH  &kp N7  &kp N8     &kp N9  &kp MINUS  &none  &kp LPAR        &kp RPAR        &none     &none     &none
&none   &kp STAR  &kp N4  &kp N5     &kp N6  &kp PLUS   &none  &mt RSHFT LBKT  &mt RCTRL RBKT  &kp RALT  &kp RGUI  &none
&trans  &none     &kp N1  &kp N2     &kp N3  &kp EQUAL  &none  &kp LBRC        &kp RBRC        &kp LT    &kp GT    &trans
                          &kp COMMA  &kp N0  &none      &none  &trans          &none
            >;
        };

        sym {
            bindings = <
&none   &kp FSLH  &kp AMPS  &kp STAR   &kp UNDER  &kp SQT    &none   &kp LPAR        &kp RPAR        &none     &none     &none
&none   &kp BSLH  &kp DLLR  &kp PRCNT  &kp CARET  &kp SEMI   &none   &mt RSHFT LBKT  &mt RCTRL RBKT  &kp RALT  &kp RGUI  &none
&trans  &kp PIPE  &kp EXCL  &kp AT     &kp HASH   &kp GRAVE  &none   &kp LBRC        &kp RBRC        &kp LT    &kp GT    &trans
                            &kp LPAR   &kp RPAR   &none      &trans  &none           &none
            >;
        };

        fun {
            bindings = <
&none   &kp F12  &kp F7  &kp F8       &kp F9     &kp PRINTSCREEN  &none  &none      &none      &none     &none     &none
&none   &kp F11  &kp F4  &kp F5       &kp F6     &kp SCROLLLOCK   &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&trans  &kp F10  &kp F1  &kp F2       &kp F3     &kp PAUSE_BREAK  &none  &none      &none      &none     &none     &trans
                         &kp K_CMENU  &kp SPACE  &kp TAB          &none  &none      &trans
            >;
        };

        trackball {
            bindings = <
&none   &none      &none      &mkp MB4   &mkp MB5   &kp KP_NUMLOCK  &none  &none  &none  &none  &none  &none
&trans  &none      &mkp MB2   &mkp MB3   &mkp MB1   &kp SCROLLLOCK  &none  &none  &none  &none  &none  &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)       &none  &none  &none  &none  &none  &trans
                              &kt LCTRL  &none      &kt LSHIFT      &none  &none  &none
            >;
        };
    };
};
